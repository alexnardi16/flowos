{
  "expo": {
    "name": "FlowOS",
    "slug": "flowos",
    "owner": "alex16nardi",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "flowos",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/95803fab-e55e-48a0-8e48-f8b504f6aeac",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "95803fab-e55e-48a0-8e48-f8b504f6aeac"
      }
    },
    "plugins": [
      "expo-router",
      ["expo-notifications", { "defaultChannel": "flowos-reminders" }],
      ["expo-calendar", { "calendarPermission": "FlowOS usa il calendario per pianificare i tuoi impegni." }],
      "expo-task-manager",
      "expo-background-task",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "FlowOS Oggi",
              "description": "Prossimo evento e task in scadenza/scadute.",
              "supportedFamilies": ["systemSmall", "systemMedium"]
            }
          ]
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "android": {
      "package": "com.alexnardi.flowos",
      "versionCode": 2,
      "permissions": ["POST_NOTIFICATIONS", "READ_CALENDAR", "WRITE_CALENDAR"]
    },
    "ios": {
      "bundleIdentifier": "com.alexnardi.flowos",
      "buildNumber": "2",
      "infoPlist": {
        "NSCalendarsFullAccessUsageDescription": "FlowOS usa il calendario per pianificare gli impegni.",
        "NSRemindersFullAccessUsageDescription": "FlowOS usa i promemoria per aiutarti a non dimenticare gli impegni.",
        "UIBackgroundModes": ["processing"],
        "BGTaskSchedulerPermittedIdentifiers": ["com.expo.modules.backgroundtask.processing"]
      }
    }
  }
}