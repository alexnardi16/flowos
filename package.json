{
  "name": "flowos",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:auth": "rm -rf .test-dist && tsc -p tests/tsconfig.auth.json && node --test tests/authFlow.test.cjs",
    "test:selectors": "node --test tests/zustandSelectors.test.cjs",
    "test:notifications": "rm -rf .test-dist-notifications && tsc -p tests/tsconfig.notifications.json && node --test tests/dailySummary.test.cjs tests/notificationDedup.test.cjs tests/reminderPlan.test.cjs",
    "test": "npm run test:auth && npm run test:selectors && npm run test:notifications",
    "validate:web": "npm run typecheck && npm test && npx expo export --platform web",
    "eas:preview": "eas update --channel preview --message \"FlowOS preview\" --environment preview",
    "eas:build:preview": "npx eas-cli build --profile preview --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.57.4",
    "expo": "~57.0.7",
    "expo-background-task": "~57.0.6",
    "expo-calendar": "~57.0.0",
    "expo-constants": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.2",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.6",
    "expo-updates": "~57.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.0"
  }
}
