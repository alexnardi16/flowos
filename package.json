{
  "name": "flowos",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {"node": ">=22"},
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:auth": "rm -rf .test-dist && tsc -p tests/tsconfig.auth.json && node --test tests/authFlow.test.cjs",
    "test:selectors": "node --test tests/zustandSelectors.test.cjs",
    "test:notifications": "rm -rf .test-dist-notifications && tsc -p tests/tsconfig.notifications.json && node --test tests/dailySummary.test.cjs tests/notificationDedup.test.cjs tests/reminderPlan.test.cjs tests/widgetData.test.cjs tests/scheduler.test.cjs tests/replanTriggers.test.cjs tests/planningSuggestions.test.cjs tests/weatherSummary.test.cjs tests/allDayDate.test.cjs tests/recurrence.test.cjs tests/itemTiming.test.cjs tests/customReminders.test.cjs",
    "test:public-site": "node --test tests/publicSite.test.cjs",
    "test": "npm run test:auth && npm run test:selectors && npm run test:notifications && npm run test:public-site",
    "validate:web": "npm run typecheck && npm test && npx expo export --platform web",
    "eas:preview": "eas update --channel preview --message \"FlowOS preview\" --environment preview",
    "eas:build:preview": "npx eas-cli build --profile preview --platform android"
  },
  "dependencies": {
    "@expo/ui": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.57.4",
    "expo": "~57.0.20",
    "expo-background-task": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.16",
    "expo-updates": "~57.0.21",
    "expo-widgets": "~57.0.17",
    "react-native-android-widget": "^0.22.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  }
}
